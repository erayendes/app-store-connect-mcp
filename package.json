{
  "name": "@erayendes/asc-mcp",
  "version": "1.3.0",
  "mcpName": "io.github.erayendes/asc-mcp",
  "publishConfig": {
    "access": "public"
  },
  "description": "Heimdall — MCP server for the Apple App Store Connect API and App Store Server API (StoreKit 2). 982 tools generated from Apple's official OpenAPI spec, AI-powered review triage and reply drafting, and confirm-before-write safety. Works with Claude, Codex, Cursor and any MCP client.",
  "author": {
    "name": "Eray Endeş",
    "email": "erayendes@gmail.com",
    "url": "https://github.com/erayendes"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erayendes/app-store-connect-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/erayendes/app-store-connect-mcp/issues"
  },
  "homepage": "https://github.com/erayendes/app-store-connect-mcp#readme",
  "funding": "https://buymeacoffee.com/erayendes",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "asc-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "spec/openapi.json",
    "README.md",
    "AGENTS.md",
    "docs/GUIDE.md",
    "docs/CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "generate": "tsx scripts/generate.ts && tsx scripts/generate-profiles.ts",
    "build": "npm run generate && tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "spec:update": "tsx scripts/update-spec.ts",
    "ax:report": "tsx scripts/ax-report.ts",
    "ax:eval": "tsx scripts/ax-eval.ts",
    "ax:agent": "tsx scripts/ax-agent.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "heimdall",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "app-store-connect",
    "appstoreconnect",
    "app-store",
    "app-store-server-api",
    "appstore",
    "asc",
    "apple",
    "ios",
    "testflight",
    "storekit",
    "subscriptions",
    "in-app-purchase",
    "app-reviews",
    "game-center",
    "xcode-cloud",
    "openapi",
    "ai",
    "claude",
    "claude-code",
    "cursor",
    "codex"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^1.6.0",
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.220",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  }
}
