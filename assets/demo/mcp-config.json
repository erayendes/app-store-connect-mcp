        "ASC_PRIVATE_KEY_KEYCHAIN": "",
        "ASC_READ_ONLY": "false",
        "ASC_DRY_RUN": "false",
        "ASC_NATIVE_CONFIRM": "0",
        "ASC_CONFIG_DIR": "assets/demo/.runtime",
        "ASC_STATE_DIR": "assets/demo/.runtime"
      }
    }
  }
}
